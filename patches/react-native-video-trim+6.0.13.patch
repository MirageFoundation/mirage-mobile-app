+  public func _mux(videoUrl: String, audioUrl: String, outputExt: String, completion: @escaping ([String: Any]) -> Void) {
+    let normalizedVideoPath = videoUrl.replacingOccurrences(of: "file://", with: "")
+    let normalizedAudioPath = audioUrl.replacingOccurrences(of: "file://", with: "")
+
+    let timestamp = Int(Date().timeIntervalSince1970)
+    let outputName = "\(FILE_PREFIX)_mux_\(timestamp).\(outputExt)"
+    let documentsDirectory = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first!
+    let outputFile = documentsDirectory.appendingPathComponent(outputName)
+
+    let cmds = [
+      "-i", normalizedVideoPath,
+      "-i", normalizedAudioPath,
+      "-c:v", "copy",
+      "-c:a", "aac",
+      "-map", "0:v:0",
+      "-map", "1:a:0",
+      "-shortest",
+      "-movflags", "+faststart",
+      outputFile.path,
+    ]
+
+    FFmpegKit.execute(withArgumentsAsync: cmds, withCompleteCallback: { session in
+      let returnCode = session?.getReturnCode()
+      if ReturnCode.isSuccess(returnCode) {
+        completion([
+          "success": true,
+          "outputPath": outputFile.absoluteString,
+        ])
+      } else if ReturnCode.isCancel(returnCode) {
+        completion([
+          "success": false,
+          "message": "FFmpeg mux was cancelled with code \(returnCode?.getValue() ?? -1)",
+        ])
+      } else {
+        completion([
+          "success": false,
