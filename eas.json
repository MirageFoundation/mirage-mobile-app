{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "sim": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "dev"
      },
      "channel": "sim",
      "android": {
        "resourceClass": "large"
      }
    },
    "dev": {
      "developmentClient": true,
      "channel": "dev",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "dev"
      },
      "android": {
        "resourceClass": "large"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "preview"
      },
      "android": {
        "resourceClass": "large"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "sdk-54",
        "node": "24.4.0"
      },
      "android": {
        "node": "24.4.0",
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
