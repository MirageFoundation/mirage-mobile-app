      "channel": "production",
      "ios": {
        "image": "macos-sonoma-14.6-xcode-16.1",
        "node": "24.4.0"
      },
      "android": {
        "node": "24.4.0"
      }
    }
  },
  "submit": {
    "production": {}
  }
